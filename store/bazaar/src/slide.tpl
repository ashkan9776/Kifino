<!doctype html><html lang="fa"><head><meta charset="utf-8"><link rel="stylesheet" href="kit.css">
<style>
html{zoom:.5;overflow:hidden}
body{width:1080px;height:1920px;overflow:hidden;position:relative}
body.light{background:linear-gradient(180deg,#EAF7F5 0%,#FAF8F4 55%,#F3F0EA 100%);color:#0F1B2E}
body.dark{background:radial-gradient(130% 80% at 100% 0%,#145a5c 0%,#0F2A38 40%,#0B1220 100%);color:#fff}
.blob{position:absolute;border-radius:50%;filter:blur(2px)}
.light .b1{width:900px;height:900px;left:-380px;top:820px;background:radial-gradient(circle,rgba(46,196,182,.30),transparent 65%)}
.light .b2{width:700px;height:700px;right:-300px;top:-250px;background:radial-gradient(circle,rgba(226,184,74,.22),transparent 65%)}
.dark .b1{width:1000px;height:1000px;left:-420px;top:900px;background:radial-gradient(circle,rgba(46,196,182,.28),transparent 65%)}
.dark .b2{width:600px;height:600px;right:-260px;top:-200px;background:radial-gradient(circle,rgba(226,184,74,.16),transparent 65%)}
header{position:absolute;top:120px;left:80px;right:80px;text-align:center}
.kick{display:inline-flex;align-items:center;gap:12px;font-size:30px;font-weight:600;padding:10px 26px;border-radius:999px;margin-bottom:34px}
.light .kick{background:#fff;color:#0B7F7A;box-shadow:0 6px 20px rgba(11,127,122,.12)}
.dark .kick{background:rgba(255,255,255,.08);color:#2EC4B6;border:1px solid rgba(255,255,255,.12)}
.kick img{width:40px;height:40px;border-radius:11px}
h1{font-size:76px;font-weight:700;line-height:1.3}
h1 b{color:#0B7F7A}.dark h1 b{color:#E2B84A}
p{font-size:34px;font-weight:500;line-height:1.65;margin-top:22px;opacity:.72}
.phone{width:770px;left:155px;top:600px}
</style></head><body class="__THEME__">
<div class="blob b1"></div><div class="blob b2"></div>
<header>
  <div class="kick"><img src="../icon-512.png">کیفینو</div>
  <h1>__TITLE__</h1>
  <p>__SUB__</p>
</header>
<div class="phone"><img src="screens/__SHOT__.png"></div>
</body></html>
